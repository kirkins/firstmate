#!/usr/bin/env bash
# Disposable keyring stub: the operator's real keyring must not be touched.
# Answers only the dedicated drain slot for the lab host, like a stored
# least-privilege token would. Log every lookup for evidence.
RIG=/tmp/fm-forge-live
printf 'lookup %s\n' "$*" >> "$RIG/secrettool.log"
if [ "$1" != lookup ] || [ "$2" != service ]; then
  exit 1
fi
mode=$(cat "$RIG/ctl/token-mode" 2>/dev/null || printf drain)
case "$mode" in
  drain)
    [ "$3" = "mailbox.test.forge/forgejo-mail/drain" ] || exit 1
    printf '%s' "faketoken0123456789abcdef" ;;
  other)
    [ "$3" = "mailbox.test.forge/forgejo-cli/omarchy" ] || exit 1
    printf '%s' "faketoken0123456789abcdef" ;;
  *) exit 1 ;;
esac
